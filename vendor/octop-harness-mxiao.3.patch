+def _validate_response(response: ModelResponse[Any]) -> ModelResponse[Any]:
+    """Reject incomplete provider replies inside the retry budget."""
+    for message in response.result:
+        if not isinstance(message, AIMessage):
+            continue
+        metadata = message.response_metadata
+        if metadata.get("finish_reason") == "error" or metadata.get("stop_reason") == "error":
+            raise ValueError("Model response ended with an error")
+        if (
+            message.tool_calls
+            or message.invalid_tool_calls
+            or message.text.strip()
+            or message.additional_kwargs.get("refusal")
+            or message.additional_kwargs.get("audio")
+            or metadata.get("stop_reason") == "refusal"
+        ):
+            return response
+        if isinstance(message.content, list) and any(
+            isinstance(block, dict)
+            and block.get("type") in {"image", "image_url", "audio", "video", "file", "refusal"}
+            and any(value for key, value in block.items() if key != "type")
+            for block in message.content
+        ):
+            return response
+    if response.structured_response is not None:
+        return response
+    raise ValueError("Model returned no usable response")
+
