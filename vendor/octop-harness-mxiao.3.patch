@@ -0,0 +1,167 @@
+"""Provider response validation must preserve meaningful non-text replies."""
+
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+from langchain.agents.middleware import ModelResponse
+from langchain_core.messages import AIMessage
+
+from octop_harness.middleware.model_retry import ModelRetryMiddleware
+
+
+@pytest.mark.parametrize(
+    "message",
+    [
+        AIMessage(content="", additional_kwargs={"refusal": "I cannot assist with that request."}),
+        AIMessage(content=[{"type": "refusal", "refusal": "I cannot assist with that request."}]),
+        AIMessage(
+            content="",
+            invalid_tool_calls=[{"name": "lookup", "args": "{", "id": "call-1", "error": "Invalid JSON"}],
+        ),
+    ],
+    ids=["provider-refusal", "refusal-block", "invalid-tool-call"],
+)
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.asyncio
+async def test_preserves_provider_refusals_and_invalid_tool_calls(message: AIMessage, asynchronous: bool) -> None:
+    response = ModelResponse(result=[message])
+    calls = 0
+    middleware = ModelRetryMiddleware(max_retries=2, initial_delay=0, jitter=False, on_failure="error")
+
+    def handler(_: Any) -> ModelResponse[Any]:
+        nonlocal calls
+        calls += 1
+        return response
+
+    async def ahandler(request: Any) -> ModelResponse[Any]:
+        return handler(request)
+
+    if asynchronous:
+        actual = await middleware.awrap_model_call(None, ahandler)  # type: ignore[arg-type]
+    else:
+        actual = middleware.wrap_model_call(None, handler)  # type: ignore[arg-type]
+    assert actual is response
+    assert calls == 1
+
+
+@pytest.mark.parametrize(
+    "response",
+    [
+        ModelResponse(result=[AIMessage(content="Useful answer")]),
+        ModelResponse(result=[AIMessage(content="", tool_calls=[{"name": "lookup", "args": {}, "id": "call-1"}])]),
+        ModelResponse(result=[AIMessage(content=[{"type": "image", "url": "https://example.invalid/a.png"}])]),
+        ModelResponse(result=[AIMessage(content=[{"type": "audio", "base64": "AA==", "mime_type": "audio/wav"}])]),
+        ModelResponse(result=[AIMessage(content="", response_metadata={"stop_reason": "refusal"})]),
+        ModelResponse(result=[AIMessage(content="", additional_kwargs={"audio": {"id": "audio-1", "data": "AA=="}})]),
+        ModelResponse(result=[], structured_response={}),
+        ModelResponse(result=[], structured_response=False),
+    ],
+    ids=["text", "tool", "image", "audio", "refusal-stop", "provider-audio", "structured-empty", "structured-false"],
+)
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.asyncio
+async def test_preserves_valid_response(response: ModelResponse[Any], asynchronous: bool) -> None:
+    middleware = ModelRetryMiddleware(max_retries=0, on_failure="error")
+
+    def handler(_: Any) -> ModelResponse[Any]:
+        return response
+
+    async def ahandler(request: Any) -> ModelResponse[Any]:
+        return handler(request)
+
+    if asynchronous:
+        assert await middleware.awrap_model_call(None, ahandler) is response  # type: ignore[arg-type]
+    else:
+        assert middleware.wrap_model_call(None, handler) is response  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    "message",
+    [
+        AIMessage(content=""),
+        AIMessage(content=" "),
+        AIMessage(content="", additional_kwargs={"reasoning_content": "Thinking"}),
+        AIMessage(content=[{"type": "reasoning", "reasoning": "Thinking"}]),
+        AIMessage(content="Partial", response_metadata={"finish_reason": "error"}),
+        AIMessage(content="Partial", response_metadata={"stop_reason": "error"}),
+    ],
+    ids=["empty", "whitespace", "reasoning-extra", "reasoning-block", "finish-error", "stop-error"],
+)
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.asyncio
+async def test_unusable_responses_consume_retry_budget(message: AIMessage, asynchronous: bool) -> None:
+    calls = 0
+    middleware = ModelRetryMiddleware(max_retries=2, initial_delay=0, jitter=False, on_failure="error")
+
+    def handler(_: Any) -> ModelResponse[Any]:
+        nonlocal calls
+        calls += 1
+        return ModelResponse(result=[message])
+
+    async def ahandler(request: Any) -> ModelResponse[Any]:
+        return handler(request)
+
+    with pytest.raises(ValueError):
+        if asynchronous:
+            await middleware.awrap_model_call(None, ahandler)  # type: ignore[arg-type]
+        else:
+            middleware.wrap_model_call(None, handler)  # type: ignore[arg-type]
+    assert calls == 3
+
+
+@pytest.mark.parametrize("streaming", [False, True])
+@pytest.mark.parametrize("recover", [False, True])
+@pytest.mark.asyncio
+async def test_graph_retries_empty_replies_without_checkpointing_them(
+    tmp_path: Any, streaming: bool, recover: bool
+) -> None:
+    from deepagents import create_deep_agent
+    from deepagents.backends import FilesystemBackend
+    from langchain_core.language_models.fake_chat_models import FakeMessagesListChatModel
+    from langchain_core.messages import HumanMessage
+    from langgraph.checkpoint.memory import InMemorySaver
+
+    class Model(FakeMessagesListChatModel):
+        attempts: int = 0
+
+        def bind_tools(self, tools: Any, **kwargs: Any) -> Any:
+            return self
+
+        def _generate(self, messages: Any, stop: Any = None, run_manager: Any = None, **kwargs: Any) -> Any:
+            self.attempts += 1
+            return super()._generate(messages, stop=stop, run_manager=run_manager, **kwargs)
+
+        async def _agenerate(self, messages: Any, stop: Any = None, run_manager: Any = None, **kwargs: Any) -> Any:
+            return self._generate(messages, stop, run_manager, **kwargs)
+
+    responses = [AIMessage(content=""), AIMessage(content="", additional_kwargs={"reasoning_content": "Thinking"})]
+    responses.append(AIMessage(content="Recovered") if recover else AIMessage(content=""))
+    model = Model(responses=responses)
+    graph = create_deep_agent(
+        model=model,
+        middleware=[ModelRetryMiddleware(max_retries=2, initial_delay=0, jitter=False, on_failure="error")],
+        checkpointer=InMemorySaver(),
+        backend=FilesystemBackend(root_dir=str(tmp_path), virtual_mode=True),
+    )
+    config = {"configurable": {"thread_id": "response-retry"}}
+
+    async def invoke() -> None:
+        inputs = {"messages": [HumanMessage(content="probe")]}
+        if streaming:
+            async for _ in graph.astream(inputs, config, stream_mode=["messages", "updates"]):
+                pass
+        else:
+            await graph.ainvoke(inputs, config)
+
+    if recover:
+        await invoke()
+    else:
+        with pytest.raises(ValueError, match="no usable response"):
+            await invoke()
+    assert model.attempts == 3
+    state = await graph.aget_state(config)
+    ai_messages = [message for message in state.values["messages"] if isinstance(message, AIMessage)]
+    assert [message.content for message in ai_messages] == (["Recovered"] if recover else [])
+    assert any(task.error for task in state.tasks) is not recover
