+        Returned messages are deep copies, suitable for seeding a new thread
+        with :meth:`aappend_messages`. No other graph state or offload identity
+        is copied. This does not include the system prompt or workspace files.
+
+        Returns an empty list when checkpointing is disabled or no history
+        exists. Checkpoint read errors propagate. Busy streams, pending graph
+        execution and HITL interrupts raise ``RuntimeError``; hosts must also
+        serialize their own invocations against the source snapshot.
+        """
+        from langchain_core.messages import BaseMessage
+
+        tid = thread_id.strip()
+        if not tid:
+            raise ValueError("thread_id must not be empty")
+        if tid in self._cancel_events or tid in self._hitl_resume_configs:
+            raise RuntimeError("cannot snapshot a busy or interrupted thread")
+        if not self._checkpointer_instance:
+            return []
+        async with self.checkpoint_activity(tid):
+            state = await self._graph.aget_state({"configurable": {"thread_id": tid}})
+            if (
+                tid in self._cancel_events
+                or tid in self._hitl_resume_configs
+                or bool(getattr(state, "next", ()))
+                or bool(getattr(state, "interrupts", ()))
+                or any(getattr(task, "interrupts", ()) for task in getattr(state, "tasks", ()))
+            ):
