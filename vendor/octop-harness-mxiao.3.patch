+"""Exercise independent interrupts produced by real create_agent Send fanout."""
+
+from __future__ import annotations
+
+import asyncio
+from typing import Any
+
+import pytest
+from langchain.agents import create_agent
+from langchain.agents.middleware import HumanInTheLoopMiddleware
+from langchain_core.language_models.fake_chat_models import FakeMessagesListChatModel
+from langchain_core.messages import AIMessage, HumanMessage
+from langchain_core.tools import StructuredTool
+from langgraph.checkpoint.memory import InMemorySaver
+from langgraph.types import interrupt
+
+from octop_harness.protocols.langgraph import LangGraphProtocol
+
+
+class ToolCallingModel(FakeMessagesListChatModel):
+    def bind_tools(self, *args: Any, **kwargs: Any) -> ToolCallingModel:
+        return self
+
+
+def _agent(writes: list[str], *, batch_first: bool = False) -> Any:
+    async def write(value: str) -> str:
+        # Finish in reverse order: projection and resume must still agree.
+        if value == "one":
+            await asyncio.sleep(0.01)
+        values = [value, f"{value}-extra"] if batch_first and value == "one" else [value]
+        response = interrupt(
+            {
+                "action_requests": [{"name": "write", "args": {"value": item}} for item in values],
+                "review_configs": [
+                    {"action_name": "write", "allowed_decisions": ["approve", "reject"]} for _ in values
+                ],
+            }
+        )
+        for item, decision in zip(values, response["decisions"], strict=True):
+            if decision == {"type": "approve"}:
+                writes.append(item)
+        return "reviewed"
+
+    tool = StructuredTool.from_function(name="write", description="Write after review", coroutine=write)
+    request = AIMessage(
+        content="", tool_calls=[{"id": v, "name": "write", "args": {"value": v}} for v in ("one", "two")]
+    )
+    return create_agent(
+        ToolCallingModel(responses=[request, AIMessage(content="done")]),
+        tools=[tool],
+        checkpointer=InMemorySaver(),
+    )
+
+
+@pytest.mark.parametrize("decisions", [("approve", "reject"), ("reject", "approve"), ("approve", "approve")])
+async def test_parallel_interrupts_are_one_review_and_resume_by_id(decisions: tuple[str, str]) -> None:
+    writes: list[str] = []
+    graph = _agent(writes)
+    config = {"configurable": {"thread_id": "parallel"}}
+    events = [event async for event in LangGraphProtocol(graph=graph).stream([HumanMessage(content="write")], config)]
+    state = await graph.aget_state(config)
+    assert len(state.interrupts) == 2
+    assert len(state.tasks) == 2
+    assert all(task.name == "tools" and task.path[0] == "__pregel_push" for task in state.tasks)
+    assert writes == []
+    hitl = [event["request"] for event in events if event["type"] == "hitl_required"]
+    assert len(hitl) == 1
+    assert [action["args"]["value"] for action in hitl[0]["action_requests"]] == ["one", "two"]
+    assert len(hitl[0]["review_configs"]) == 2
+    # A fresh protocol instance must recover the mapping from the checkpoint.
+    resumed = [
+        event
+        async for event in LangGraphProtocol(graph=graph).resume_stream(
+            "parallel", [{"type": decision} for decision in decisions], {}
+        )
+    ]
+    assert not [event for event in resumed if event["type"] == "hitl_required"]
+    assert sorted(writes) == [
+        value for value, decision in zip(("one", "two"), decisions, strict=True) if decision == "approve"
+    ]
+    assert not (await graph.aget_state(config)).interrupts
+
+
+@pytest.mark.parametrize("count", [0, 1, 3])
+async def test_parallel_decision_count_mismatch_executes_nothing(count: int) -> None:
+    writes: list[str] = []
+    graph = _agent(writes)
+    config = {"configurable": {"thread_id": "mismatch"}}
+    _ = [event async for event in LangGraphProtocol(graph=graph).stream([HumanMessage(content="write")], config)]
+    with pytest.raises(ValueError, match="decision"):
+        _ = [
+            event
+            async for event in LangGraphProtocol(graph=graph).resume_stream(
+                "mismatch", [{"type": "approve"}] * count, {}
+            )
+        ]
+    assert writes == []
+    assert len((await graph.aget_state(config)).interrupts) == 2
+
+
+async def test_parallel_interrupts_slice_multi_action_batches() -> None:
+    writes: list[str] = []
+    graph = _agent(writes, batch_first=True)
+    config = {"configurable": {"thread_id": "mixed-batches"}}
+    events = [event async for event in LangGraphProtocol(graph=graph).stream([HumanMessage(content="write")], config)]
+    request = next(event["request"] for event in events if event["type"] == "hitl_required")
+    assert [action["args"]["value"] for action in request["action_requests"]] == ["one", "one-extra", "two"]
+    _ = [
+        event
+        async for event in LangGraphProtocol(graph=graph).resume_stream(
+            "mixed-batches", [{"type": decision} for decision in ("approve", "reject", "approve")], {}
+        )
+    ]
+    assert sorted(writes) == ["one", "two"]
+    assert not (await graph.aget_state(config)).interrupts
+
+
+async def test_single_middleware_interrupt_keeps_its_batched_decisions() -> None:
+    writes: list[str] = []
+
+    async def write(value: str) -> str:
+        writes.append(value)
+        return "written"
+
+    tool = StructuredTool.from_function(name="write", description="Write after review", coroutine=write)
+    request = AIMessage(
+        content="", tool_calls=[{"id": value, "name": "write", "args": {"value": value}} for value in ("one", "two")]
+    )
+    graph = create_agent(
+        ToolCallingModel(responses=[request, AIMessage(content="done")]),
+        tools=[tool],
+        middleware=[HumanInTheLoopMiddleware(interrupt_on={"write": True})],
+        checkpointer=InMemorySaver(),
+    )
+    config = {"configurable": {"thread_id": "middleware-batch"}}
+    events = [event async for event in LangGraphProtocol(graph=graph).stream([HumanMessage(content="write")], config)]
+    assert len((await graph.aget_state(config)).interrupts) == 1
+    reviews = [event["request"] for event in events if event["type"] == "hitl_required"]
+    assert len(reviews) == 1
+    assert len(reviews[0]["action_requests"]) == 2
+    assert writes == []
+    _ = [
+        event
+        async for event in LangGraphProtocol(graph=graph).resume_stream(
+            "middleware-batch", [{"type": "approve"}, {"type": "reject"}], {}
+        )
+    ]
+    assert writes == ["one"]
+    assert not (await graph.aget_state(config)).interrupts
