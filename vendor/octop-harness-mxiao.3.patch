+"""Effective conversation snapshots without model calls or shared thread state."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+from typing import Annotated, Any, TypedDict
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+from deepagents.middleware.summarization import SummarizationMiddleware
+from langchain_core.messages import AIMessage, BaseMessage, HumanMessage
+from langgraph.checkpoint.memory import MemorySaver
+from langgraph.graph import END, START, StateGraph
+from langgraph.graph.message import add_messages
+
+from octop_harness.agent import HarnessAgent
+from octop_harness.middleware.summarization_limits import harden_summarization_middleware
+
+
+@pytest.fixture
+def agent() -> HarnessAgent:
+    runtime = object.__new__(HarnessAgent)
+    runtime._checkpointer_instance = MagicMock()
+    runtime._graph = SimpleNamespace(
+        aget_state=AsyncMock(return_value=SimpleNamespace(values={}, next=(), tasks=(), interrupts=()))
+    )
+    runtime._summarization_mw = None
+    runtime._cancel_events = {}
+    runtime._hitl_resume_configs = {}
+    return runtime
+
+
+@pytest.mark.asyncio
+async def test_uncompacted_snapshot_keeps_all_messages_and_deepcopies(agent: HarnessAgent) -> None:
+    messages = [HumanMessage(content=str(index), id=f"m-{index}") for index in range(60)]
+    messages.append(
+        AIMessage(
+            content=[{"type": "text", "text": "answer"}],
+            additional_kwargs={"nested": {"items": ["parent"]}},
+        )
+    )
+    agent._graph.aget_state.return_value = SimpleNamespace(
+        values={"messages": messages}, next=(), tasks=(), interrupts=()
+    )
+
+    snapshot = await agent.aget_effective_messages(" parent ")
+
+    assert snapshot == messages
+    assert snapshot is not messages
+    assert all(copied is not source for copied, source in zip(snapshot, messages, strict=True))
+    snapshot[-1].content[0]["text"] = "child"
+    snapshot[-1].additional_kwargs["nested"]["items"].append("child")
+    assert messages[-1].content == [{"type": "text", "text": "answer"}]
+    assert messages[-1].additional_kwargs == {"nested": {"items": ["parent"]}}
+    agent._graph.aget_state.assert_awaited_once_with({"configurable": {"thread_id": "parent"}})
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("cutoff", [2, 200])
+async def test_compacted_snapshot_uses_runtime_summary_and_tail(
+    agent: HarnessAgent, monkeypatch: pytest.MonkeyPatch, cutoff: int
+) -> None:
+    monkeypatch.setenv("OCTOP_SUMMARY_FALLBACK_KEEP", "2")
+    agent._summarization_mw = harden_summarization_middleware(object.__new__(SummarizationMiddleware))
+    messages = [HumanMessage(content=str(index), id=f"m-{index}") for index in range(4)]
+    summary = HumanMessage(content="earlier decisions", additional_kwargs={"nested": {"items": ["parent"]}})
+    event = {"cutoff_index": cutoff, "summary_message": summary, "file_path": "/history/parent.md"}
+    agent._graph.aget_state.return_value = SimpleNamespace(
+        values={"messages": messages, "_summarization_event": event, "_summarization_session_id": "parent-session"},
+        next=(),
+        tasks=(),
+        interrupts=(),
+    )
+
+    snapshot = await agent.aget_effective_messages("parent")
+
+    assert snapshot == [summary, *messages[2:]]
+    assert snapshot[0] is not summary
+    snapshot[0].additional_kwargs["nested"]["items"].append("child")
+    assert summary.additional_kwargs == {"nested": {"items": ["parent"]}}
+    assert event["file_path"] == "/history/parent.md"
+
+
+@pytest.mark.asyncio
+async def test_compacted_snapshot_locates_cutoff_by_message_id(agent: HarnessAgent) -> None:
+    agent._summarization_mw = harden_summarization_middleware(object.__new__(SummarizationMiddleware))
+    messages = [HumanMessage(content=str(index), id=f"m-{index}") for index in range(4)]
+    summary = HumanMessage(content="earlier decisions")
+    agent._graph.aget_state.return_value = SimpleNamespace(
+        values={
+            "messages": messages,
+            "_summarization_event": {"cutoff_index": 200, "cutoff_message_id": "m-2", "summary_message": summary},
+        },
+        next=(),
+        tasks=(),
+        interrupts=(),
+    )
+
+    assert await agent.aget_effective_messages("parent") == [summary, *messages[2:]]
+
+
+@pytest.mark.asyncio
+async def test_summary_without_runtime_middleware_fails_closed(agent: HarnessAgent) -> None:
+    agent._graph.aget_state.return_value = SimpleNamespace(
+        values={
+            "messages": [HumanMessage(content="summarized raw history")],
+            "_summarization_event": {"cutoff_index": 1, "summary_message": HumanMessage(content="summary")},
+        },
+        next=(),
+        tasks=(),
+        interrupts=(),
+    )
+
+    with pytest.raises(RuntimeError, match="summarization middleware"):
+        await agent.aget_effective_messages("parent")
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("tracking", ["_cancel_events", "_hitl_resume_configs"])
+async def test_rejects_locally_busy_or_approval_source(agent: HarnessAgent, tracking: str) -> None:
+    getattr(agent, tracking)["parent"] = MagicMock()
+
+    with pytest.raises(RuntimeError, match=r"busy|interrupt"):
+        await agent.aget_effective_messages("parent")
+
+    agent._graph.aget_state.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "pending",
+    [
+        {"next": ("tools",)},
+        {"interrupts": (SimpleNamespace(value={"action_requests": []}),)},
+        {"tasks": (SimpleNamespace(interrupts=(SimpleNamespace(value="approve"),)),)},
+    ],
+)
+async def test_rejects_persisted_pending_or_approval_source(agent: HarnessAgent, pending: dict[str, object]) -> None:
+    fields = {"values": {"messages": [HumanMessage(content="pending")]}, "next": (), "tasks": (), "interrupts": ()}
+    fields.update(pending)
+    agent._graph.aget_state.return_value = SimpleNamespace(**fields)
+
+    with pytest.raises(RuntimeError, match=r"busy|interrupt"):
+        await agent.aget_effective_messages("parent")
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("values", [{}, {"messages": []}])
+async def test_missing_history_returns_empty(agent: HarnessAgent, values: dict[str, object]) -> None:
+    agent._graph.aget_state.return_value = SimpleNamespace(values=values, next=(), tasks=(), interrupts=())
+
+    assert await agent.aget_effective_messages("missing") == []
+
+
+@pytest.mark.asyncio
+async def test_disabled_checkpointer_returns_empty(agent: HarnessAgent) -> None:
+    agent._checkpointer_instance = False
+
+    assert await agent.aget_effective_messages("missing") == []
+    agent._graph.aget_state.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_empty_thread_id_is_rejected(agent: HarnessAgent) -> None:
+    with pytest.raises(ValueError, match="thread_id"):
+        await agent.aget_effective_messages(" ")
+
+    agent._graph.aget_state.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_checkpoint_error_is_not_reported_as_missing_history(agent: HarnessAgent) -> None:
+    agent._graph.aget_state.side_effect = OSError("checkpoint unavailable")
+
+    with pytest.raises(OSError, match="checkpoint unavailable"):
+        await agent.aget_effective_messages("parent")
+
+
+class _SnapshotState(TypedDict, total=False):
+    messages: Annotated[list[BaseMessage], add_messages]
+    _summarization_event: dict[str, Any]
+    _summarization_session_id: str
+    files: dict[str, Any]
+    todos: list[dict[str, Any]]
+
+
+@pytest.mark.asyncio
+async def test_snapshot_seeds_only_messages_and_threads_continue_independently(agent: HarnessAgent) -> None:
+    checkpointer = MemorySaver()
+    builder = StateGraph(_SnapshotState)
+    builder.add_node("finish", lambda _state: {})
+    builder.add_edge(START, "finish")
+    builder.add_edge("finish", END)
+    graph = builder.compile(checkpointer=checkpointer)
+    agent._checkpointer_instance = checkpointer
+    agent._graph = graph
+    agent._summarization_mw = harden_summarization_middleware(object.__new__(SummarizationMiddleware))
+    parent_config = {"configurable": {"thread_id": "parent"}}
+    child_config = {"configurable": {"thread_id": "child"}}
+    summary = HumanMessage(content="parent decisions", id="summary")
+    await graph.ainvoke(
+        {
+            "messages": [HumanMessage(content="evicted", id="old"), AIMessage(content="retained", id="tail")],
+            "_summarization_event": {"cutoff_index": 1, "summary_message": summary, "file_path": "/parent.md"},
+            "_summarization_session_id": "parent-offload-id",
+            "files": {"/parent.md": {"content": ["parent-only"]}},
+            "todos": [{"content": "parent task", "status": "in_progress"}],
+        },
+        parent_config,
+    )
+
+    snapshot = await agent.aget_effective_messages("parent")
+    await agent.aappend_messages("child", snapshot)
+    child = await graph.aget_state(child_config)
+    assert set(child.values) == {"messages"}
+    assert [message.content for message in child.values["messages"]] == ["parent decisions", "retained"]
+
+    await agent.aappend_messages("parent", [HumanMessage(content="parent continuation", id="parent-next")])
+    await agent.aappend_messages("child", [HumanMessage(content="child continuation", id="child-next")])
+    parent = await graph.aget_state(parent_config)
+    child = await graph.aget_state(child_config)
+    assert [message.content for message in parent.values["messages"]] == ["evicted", "retained", "parent continuation"]
+    assert [message.content for message in child.values["messages"]] == [
+        "parent decisions",
+        "retained",
+        "child continuation",
+    ]
+    assert parent.values["_summarization_session_id"] == "parent-offload-id"
+    assert parent.values["files"]["/parent.md"]["content"] == ["parent-only"]
+    assert parent.values["todos"] == [{"content": "parent task", "status": "in_progress"}]
