@@ -0,0 +1,113 @@
+"""OpenAI Images API adapter for synchronous GPT Image generation and edits."""
+
+from __future__ import annotations
+
+import base64
+from collections.abc import Mapping
+from typing import Any
+
+import httpx
+
+from octop_harness.media.errors import MediaGenerationError
+from octop_harness.media.http import BearerJsonMediaProvider, detect_media, provider_payload_error
+from octop_harness.media.models import (
+    ImageGenerationRequest,
+    MediaCapabilities,
+    MediaJobUpdate,
+    MediaSubmission,
+    ProviderTask,
+    RemoteArtifact,
+    VideoGenerationRequest,
+)
+
+
+class OpenAIImagesMediaProvider(BearerJsonMediaProvider):
+    """Call OpenAI Images endpoints; this protocol does not support video."""
+
+    provider_id = "openai_images"
+    capabilities = MediaCapabilities(video_generation=False, image_references=True)
+
+    async def _submit_image(
+        self,
+        client: httpx.AsyncClient,
+        request: ImageGenerationRequest,
+    ) -> MediaSubmission:
+        body: dict[str, Any] = {
+            "model": self.image_model,
+            "prompt": request.prompt,
+            "n": request.count,
+            "output_format": "png",
+        }
+        if request.size:
+            body["size"] = request.size
+        if len(request.reference_images) > 16:
+            raise MediaGenerationError("OpenAI accepts at most 16 reference images", code="invalid_request")
+        if request.reference_images:
+            field = "image[]" if len(request.reference_images) > 1 else "image"
+            files = []
+            for index, reference in enumerate(request.reference_images):
+                data, media_type, extension = await self._reference_image(client, reference)
+                files.append((field, (f"reference-{index}.{extension}", data, media_type)))
+            payload = await self._request_json(
+                client, "POST", "/images/edits", data={key: str(value) for key, value in body.items()}, files=files
+            )
+        else:
+            payload = await self._request_json(client, "POST", "/images/generations", json=body)
+        return MediaSubmission(artifacts=_image_artifacts(payload))
+
+    async def _reference_image(self, client: httpx.AsyncClient, reference: str) -> tuple[bytes, str, str]:
+        if reference.startswith("data:"):
+            header, separator, encoded = reference.partition(",")
+            try:
+                if not separator or not header.endswith(";base64"):
+                    raise ValueError("expected a base64 data URL")
+                data = base64.b64decode(encoded, validate=True)
+            except ValueError as exc:
+                raise MediaGenerationError("Invalid reference image data URL", code="invalid_request") from exc
+        else:
+            data = await self._download(client, reference)
+        media_type, extension = detect_media(data, fallback_type="application/octet-stream", fallback_extension="bin")
+        if media_type not in {"image/png", "image/jpeg", "image/webp"}:
+            raise MediaGenerationError("OpenAI reference images must be PNG, JPEG or WebP", code="invalid_request")
+        return data, media_type, extension
+
+    async def _submit_video(self, client: httpx.AsyncClient, request: VideoGenerationRequest) -> MediaSubmission:
+        raise MediaGenerationError("OpenAI Images does not support video generation", code="unsupported_capability")
+
+    async def _poll_task(self, client: httpx.AsyncClient, task: ProviderTask) -> MediaJobUpdate:
+        raise MediaGenerationError(
+            "OpenAI Images returns synchronous results, not tasks", code="unsupported_capability"
+        )
+
+
+def _image_artifacts(payload: Mapping[str, Any]) -> tuple[RemoteArtifact, ...]:
+    if payload.get("error"):
+        raise provider_payload_error(payload["error"], fallback="OpenAI image generation failed")
+    rows = payload.get("data")
+    if not isinstance(rows, list) or not rows:
+        raise MediaGenerationError("OpenAI image generation returned no images", code="provider_response_invalid")
+    artifacts: list[RemoteArtifact] = []
+    for row in rows:
+        if not isinstance(row, Mapping):
+            continue
+        encoded = row.get("b64_json")
+        if isinstance(encoded, str) and encoded:
+            try:
+                data = base64.b64decode(encoded, validate=True)
+            except ValueError as exc:
+                raise MediaGenerationError(
+                    "OpenAI returned invalid base64 image data", code="provider_response_invalid"
+                ) from exc
+            artifacts.append(RemoteArtifact(data=data, media_type="image/png", extension="png"))
+            continue
+        url = row.get("url")
+        if isinstance(url, str) and url:
+            artifacts.append(RemoteArtifact(url=url, media_type="image/png", extension="png"))
+    if not artifacts:
+        raise MediaGenerationError(
+            "OpenAI image generation returned no usable images", code="provider_response_invalid"
+        )
+    return tuple(artifacts)
+
+
+__all__ = ["OpenAIImagesMediaProvider"]
diff --git a/tests/test_openai_images.py b/tests/test_openai_images.py
new file mode 100644
index 0000000..5951f9b
--- /dev/null
+++ b/tests/test_openai_images.py
@@ -0,0 +1,257 @@
+"""Offline tests for the OpenAI Images protocol adapter."""
+
+from __future__ import annotations
+
+import base64
+import json
+from email import message_from_bytes
+from email.policy import default
+from pathlib import Path
+
+import httpx
+import pytest
+from deepagents.backends import FilesystemBackend
+
+from octop_harness.backends.workspace import BackendWorkspace
+from octop_harness.config import MediaGenerationConfig, MediaProviderConfig
+from octop_harness.media.errors import MediaGenerationError
+from octop_harness.media.manager import MediaManager
+from octop_harness.media.models import ImageGenerationRequest, ProviderTask, VideoGenerationRequest
+from octop_harness.media.registry import create_media_manager, create_media_provider
+
+_PNG = bytes.fromhex("89504e470d0a1a0a") + b"image-bytes"
+
+
+@pytest.mark.parametrize("named", [False, True])
+def test_openai_images_defaults_are_image_only(named: bool, monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setenv("OPENAI_API_KEY", "sk-xxx")
+    config = (
+        MediaProviderConfig(id="openai-images", provider="openai_images")
+        if named
+        else MediaGenerationConfig(provider="openai_images")
+    )
+
+    assert config.base_url == "https://api.openai.com/v1"
+    assert config.api_key_env == "OPENAI_API_KEY"
+    assert config.image_model == "gpt-image-2"
+    assert config.video_model == ""
+    assert config.image_enabled is True
+    assert config.video_enabled is False
+    assert config.resolve_api_key() == "sk-xxx"
+    serialized = config.to_dict()
+    assert "api_key" not in serialized
+    assert type(config).from_dict(serialized).to_dict() == serialized
+
+
+@pytest.mark.asyncio
+async def test_generate_image_sends_images_json_and_stores_base64(tmp_path: Path) -> None:
+    def handler(request: httpx.Request) -> httpx.Response:
+        assert request.method == "POST"
+        assert str(request.url) == "https://api.openai.com/v1/images/generations"
+        assert request.headers["authorization"] == "Bearer sk-xxx"
+        assert json.loads(request.content) == {
+            "model": "gpt-image-2",
+            "prompt": "a paper boat",
+            "n": 2,
+            "size": "1024x1536",
+            "output_format": "png",
+        }
+        return httpx.Response(200, json={"data": [{"b64_json": base64.b64encode(_PNG).decode()}] * 2})
+
+    config = MediaProviderConfig(id="images", provider="openai_images", api_key="sk-xxx")
+    workspace = BackendWorkspace(FilesystemBackend(root_dir=str(tmp_path), virtual_mode=True), tmp_path)
+    async with httpx.AsyncClient(transport=httpx.MockTransport(handler)) as client:
+        provider = create_media_provider(config, client=client)
+        assert type(provider).__name__ == "OpenAIImagesMediaProvider"
+        assert provider.capabilities.image_references is True
+        assert provider.capabilities.video_generation is False
+        manager = MediaManager(workspace, output_dir="generated")
+        manager.add_provider("images", provider, video_enabled=False)
+        result = await manager.generate_image(ImageGenerationRequest(prompt="a paper boat", count=2, size="1024x1536"))
+
+    assert result.provider_type == "openai_images"
+    assert result.model == "gpt-image-2"
+    assert len(result.artifacts) == 2
+    assert all(artifact.media_type == "image/png" for artifact in result.artifacts)
+    assert all(Path(artifact.local_path).read_bytes() == _PNG for artifact in result.artifacts)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("references", [("reference.png",), ("reference.png", "https://references.example/ref.png")])
+async def test_reference_edit_uploads_multipart_images(tmp_path: Path, references: tuple[str, ...]) -> None:
+    seen: list[str] = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        seen.append(str(request.url))
+        if request.url.host == "references.example":
+            assert "authorization" not in request.headers
+            return httpx.Response(200, content=_PNG, headers={"content-type": "image/png"})
+        assert str(request.url) == "https://api.openai.com/v1/images/edits"
+        assert request.headers["authorization"] == "Bearer sk-xxx"
+        assert request.headers["content-type"].startswith("multipart/form-data; boundary=")
+        message = message_from_bytes(
+            b"Content-Type: " + request.headers["content-type"].encode() + b"\r\n\r\n" + request.content,
+            policy=default,
+        )
+        parts = list(message.iter_parts())
+        fields = {part.get_param("name", header="content-disposition"): part.get_payload(decode=True) for part in parts}
+        image_field = "image[]" if len(references) > 1 else "image"
+        assert set(fields) == {"model", "prompt", "n", "output_format", "size", image_field}
+        assert fields["model"] == b"gpt-image-2"
+        assert fields["prompt"] == b"make a paper boat"
+        assert fields["n"] == b"1"
+        assert fields["output_format"] == b"png"
+        assert fields["size"] == b"1024x1024"
+        image_parts = [part for part in parts if part.get_filename()]
+        assert len(image_parts) == len(references)
+        assert all(part.get_content_type() == "image/png" for part in image_parts)
+        assert all(part.get_payload(decode=True) == _PNG for part in image_parts)
+        return httpx.Response(200, json={"data": [{"b64_json": base64.b64encode(_PNG).decode()}]})
+
+    workspace = BackendWorkspace(FilesystemBackend(root_dir=str(tmp_path), virtual_mode=True), tmp_path)
+    workspace.upload_bytes("reference.png", _PNG)
+    async with httpx.AsyncClient(transport=httpx.MockTransport(handler)) as client:
+        provider = create_media_provider(
+            MediaProviderConfig(id="images", provider="openai_images", api_key="sk-xxx"), client=client
+        )
+        manager = MediaManager(workspace, output_dir="generated")
+        manager.add_provider("images", provider, video_enabled=False)
+        result = await manager.generate_image(
+            ImageGenerationRequest(prompt="make a paper boat", reference_images=references, size="1024x1024")
+        )
+
+    assert Path(result.artifacts[0].local_path).read_bytes() == _PNG
+    assert seen[-1] == "https://api.openai.com/v1/images/edits"
+
+
+@pytest.mark.asyncio
+async def test_openai_images_rejects_too_many_references_before_http() -> None:
+    def handler(request: httpx.Request) -> httpx.Response:
+        pytest.fail(f"Unexpected HTTP request: {request.url}")
+
+    async with httpx.AsyncClient(transport=httpx.MockTransport(handler)) as client:
+        provider = create_media_provider(
+            MediaGenerationConfig(provider="openai_images", api_key="sk-xxx"), client=client
+        )
+        with pytest.raises(MediaGenerationError, match="16 reference images") as caught:
+            await provider.submit_image(
+                ImageGenerationRequest(prompt="combine", reference_images=("https://refs.example/image.png",) * 17)
+            )
+    assert caught.value.code == "invalid_request"
+
+
+@pytest.mark.asyncio
+async def test_openai_images_video_is_disabled_without_affecting_other_routes(tmp_path: Path) -> None:
+    workspace = BackendWorkspace(FilesystemBackend(root_dir=str(tmp_path), virtual_mode=True), tmp_path)
+    config = MediaGenerationConfig(
+        providers=[
+            MediaProviderConfig(id="images", provider="openai_images", api_key="sk-xxx", video_enabled=True),
+            MediaProviderConfig(id="video", provider="minimax", api_key="sk-xxx", image_enabled=False),
+        ],
+    )
+    manager = create_media_manager(config, workspace)
+    assert manager.route_info("image").provider_type == "openai_images"
+    assert manager.route_info("video").provider_type == "minimax"
+    with pytest.raises(MediaGenerationError) as caught:
+        await manager.generate_video(VideoGenerationRequest(prompt="a boat"), provider_id="images")
+    assert caught.value.code == "media_capability_disabled"
+
+    single = create_media_manager(MediaGenerationConfig(provider="openai_images"), workspace)
+    assert single.has_route("image")
+    assert not single.has_route("video")
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        pytest.fail(f"Unexpected HTTP request: {request.url}")
+
+    async with httpx.AsyncClient(transport=httpx.MockTransport(handler)) as client:
+        provider = create_media_provider(config.providers[0], client=client)
+        with pytest.raises(MediaGenerationError) as direct:
+            await provider.generate_video(VideoGenerationRequest(prompt="a boat"))
+        assert direct.value.code == "unsupported_capability"
+        with pytest.raises(MediaGenerationError, match="synchronous"):
+            await provider.poll(ProviderTask(task_id="unused", kind="image", model="gpt-image-2"))
+
+
+@pytest.mark.asyncio
+async def test_openai_images_downloads_result_url_without_bearer() -> None:
+    def handler(request: httpx.Request) -> httpx.Response:
+        if request.url.host == "cdn.example":
+            assert "authorization" not in request.headers
+            return httpx.Response(200, content=_PNG)
+        assert str(request.url) == "https://images.example/v1/images/generations"
+        assert request.headers["authorization"] == "Bearer sk-xxx"
+        assert json.loads(request.content)["model"] == "custom-image-model"
+        assert "size" not in json.loads(request.content)
+        return httpx.Response(200, json={"data": [{"url": "https://cdn.example/output.png"}]})
+
+    config = MediaGenerationConfig(
